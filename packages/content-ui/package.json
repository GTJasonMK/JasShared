{
  "name": "@jas/content-ui",
  "version": "0.6.2",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./host": { "types": "./dist/ContentHost.d.ts", "default": "./dist/ContentHost.js" },
    "./images": { "types": "./dist/imageDimensions.d.ts", "default": "./dist/imageDimensions.js" },
    "./views": { "types": "./dist/DetailViews.d.ts", "default": "./dist/DetailViews.js" },
    "./lists": { "types": "./dist/ListViews.d.ts", "default": "./dist/ListViews.js" },
    "./article": { "types": "./dist/ArticleBody.d.ts", "default": "./dist/ArticleBody.js" },
    "./markdown": { "types": "./dist/MarkdownRenderer.d.ts", "default": "./dist/MarkdownRenderer.js" },
    "./diary": { "types": "./dist/DiaryDayView.d.ts", "default": "./dist/DiaryDayView.js" },
    "./roadmap-ui": { "types": "./dist/roadmap-ui.d.ts", "default": "./dist/roadmap-ui.js" }
  },
  "dependencies": {
    "@jas/graph-core": "0.2.0",
    "@jas/content-core": "0.6.0",
    "@jas/graph-ui": "0.3.0",
    "katex": "0.16.28",
    "mermaid": "11.12.2",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "peerDependencies": { "react": "^19.0.0", "react-dom": "^19.0.0", "@xyflow/react": "^12.10.0" }
}
